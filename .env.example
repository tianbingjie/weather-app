# WeatherCN API Key（必填，从 WeatherCN 控制台获取）
WEATHER_API_KEY=YOUR_API_KEY

# 上游 API 基础地址（一般不需要改）
# WEATHER_BASE_URL=https://openapi.weathercn.com

# 每日上游 API 调用配额（自然日重置），<= 0 表示不限制
WEATHER_DAILY_QUOTA=400

# 上游请求速率上限（次/秒），<= 0 表示不限制
WEATHER_QPS_LIMIT=5

# 请求超时（秒）
# WEATHER_REQUEST_TIMEOUT=12

# 各端点缓存 TTL（秒），按需调整
# CACHE_TTL_CURRENT=600
# CACHE_TTL_MINUTE=1800
# CACHE_TTL_HOURLY=3600
# CACHE_TTL_ALERTS=3600
# CACHE_TTL_AIR=7200
# CACHE_TTL_DAILY=21600
# CACHE_TTL_INDICES=43200
# CACHE_TTL_SEARCH=86400
# CACHE_TTL_LOCATE=86400
